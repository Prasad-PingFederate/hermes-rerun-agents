# ==============================================================================
# Hermes + Rerun Autonomous AI Agent Configuration
# ==============================================================================

# 1. AI Engine (Gemini Flash - Free Tier from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Local Ollama Model (100% Free / Offline)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:latest

# 2. Rerun Bridge / Agent Worker Settings
RERUN_SERVER_HOST=127.0.0.1
RERUN_SERVER_PORT=8000
HERMES_API_TOKEN=your_secure_token_here
WEBHOOK_SECRET=your_github_webhook_secret_here
AUTO_HEAL_ENABLED=true
AUTO_ROLLBACK_ON_REGRESSION=true

# 3. Target Workspace for Time Machine Sandbox (defaults to current working directory)
TARGET_WORKSPACE_PATH=.
