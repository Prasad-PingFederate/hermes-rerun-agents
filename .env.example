# ==============================================================================
# Hermes + Rerun Multi-Agent Orchestrator Configuration
# ==============================================================================

# Working local example (Ollama - 100% offline & local)
HERMES_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
RERUN_TIER3_MODEL=qwen2.5-coder:7b
RERUN_TIER2_MODEL=qwen2.5-coder:32b
RERUN_TIER4_MODEL=qwen2.5-coder:32b
RERUN_TIER1_MODEL=qwen2.5-coder:32b

# Mixed team: local junior, Claude senior, Grok critic
# HERMES_AGENT_DEVELOPER_AGENT_MODEL=ollama:qwen2.5-coder:7b
# HERMES_AGENT_TEST_CASE_WRITER_AGENT_MODEL=ollama:qwen2.5-coder:7b
# HERMES_AGENT_TEST_HEALER_AGENT_MODEL=ollama:qwen2.5-coder:7b
# HERMES_AGENT_REQUIREMENTS_AGENT_MODEL=anthropic:claude-sonnet-4-5
# HERMES_AGENT_SCRUM_MASTER_ORCHESTRATOR_MODEL=grok:grok-4
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

